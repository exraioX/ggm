# O núcleo escuta somente em loopback por padrão.
PORT=8765
HOST=127.0.0.1

# Pasta que os servidores MCP devem considerar como raiz de trabalho.
GODMODE_WORKSPACE=..

# Arquivos de configuração e memória fora da pasta do projeto.
GODMODE_HOME=

# Origens locais adicionais permitidas (se for integrar a interface original).
GODMODE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Caminhos alternativos para arquivos de configuração.
# GODMODE_PROVIDER_CONFIG=
# GODMODE_MCP_CONFIG=

# Inicialização automática de servidores MCP.
# Na primeira execução, o Core cria 3 servidores essenciais se ainda não houver mcp-servers.json.
GODMODE_MCP_AUTOSTART=true
GODMODE_MCP_DEFAULTS=true
