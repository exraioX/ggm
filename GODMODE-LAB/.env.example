# GODMODE LAB local gateway
PORT=8765
# Relative to GODMODE-LAB. The folder should contain the G0DM0D3 project.
GODMODE_LAB_WORKSPACE=../G0DM0D3
# Optional: comma-separated additional local browser origins.
GODMODE_LAB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional overrides if executables are not on PATH.
GODMODE_LAB_NPX=npx
GODMODE_LAB_UVX=uvx
GODMODE_LAB_HEADROOM=headroom
GOLDIE_MCP_COMMAND=

# Goldie shared memory backend (only used after Goldie is installed and enabled).
GOLDIE_DB_PATH=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
